"""The autouse no-network guard — every test in this repo inherits it.

Poured by python-repo-template so a star is born with it rather than adopting
it after an incident. The incident it answers (stellar-core, 2026-09-17): a
suite that was "offline" only because of a value it happened to pass, so a
single source mutant made it publish real heartbeats onto live stars' topics
from inside the cluster, where the broker resolves. A guard a test INHERITS
beats one a test must REMEMBER, and no source mutant can undo an autouse
fixture.

``forge_testkit.config.no_network`` ships as a context manager plus settings
data, NOT a pytest plugin, so every repo owns this fixture (the deliberate
design: no plugin a consumer is forced to install). It blocks AF_INET and
AF_INET6 only — a local AF_UNIX socketpair, asyncio's event-loop self-pipe,
passes through, so merely spinning a loop is not a false failure. A test that
legitimately opens a real socket opts out with ``@pytest.mark.allow_network``,
registered in pyproject's ``[tool.pytest.ini_options] markers``.

Full recipe: foundry-stocks ``templates/fail-loud-die.md``.
"""

from __future__ import annotations

from typing import TYPE_CHECKING

import pytest
from forge_testkit.config import no_network

if TYPE_CHECKING:
    from collections.abc import Iterator


@pytest.fixture(autouse=True)
def _block_network(request: pytest.FixtureRequest) -> Iterator[None]:
    """Block real outbound sockets for every test, unless marked allow_network."""
    if request.node.get_closest_marker("allow_network") is not None:
        yield
        return
    with no_network():
        yield
