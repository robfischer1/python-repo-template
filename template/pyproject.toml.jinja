[project]
name = "{{ service_name }}"
dynamic = ["version"]
description = "{{ description }}"
requires-python = ">=3.14"
license = "Apache-2.0"
authors = [{ name = "{{ author_name }}" }]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Programming Language :: Python :: 3.14",
    "Operating System :: OS Independent",
]
dependencies = [
    "pydantic-settings>=2.0",
    # The op-contract ({live, ready, metrics}), the Nyx admission client, and the
    # Hemera OTLP helper come from the stellar_core SDK — pre-baked into the
    # stellar_core base image (warm builds), resolved from the Forgejo PyPI for
    # local dev. The CI admission gate is still a CI-time tool pulled ephemerally
    # by .forgejo/workflows/admit.yml, not a project dependency.
    "stellar-core>=1.0.3",
{%- if mcp %}
    # Pinned to a minor: mcp's transport-security defaults (DNS-rebinding) shift
    # across minors, and an unpinned floor let stars stamped days apart resolve
    # different versions. Renovate bumps this; server.py configures allowed_hosts.
    "mcp[cli]~=1.28.1",
{%- endif %}
{%- if core_backed %}
    "mnemosyne-core>=0.2.0",
{%- endif %}
]

[project.urls]
Repository = "https://github.com/robfischer1/{{ service_name }}"
{%- if mcp %}

[project.scripts]
{{ service_name }} = "{{ package_name }}.server:main"
{%- endif %}

[project.optional-dependencies]
dev = [
    "pytest>=8",
    "pytest-cov>=5",
    "ruff==0.16.0",
    "mypy>=1.10",
    "pyright==1.1.411",
    "pre-commit>=3.5",
    # The three forge-testkit lints the pre-commit config runs. DECLARED HERE,
    # not assumed: the hooks landed in v0.16.3 and this dep never did, so every
    # scaffold since has shipped three hooks calling a package `uv run --extra
    # dev` cannot resolve. Existing stars only work because the pin was added by
    # hand, one repo at a time. >=0.3.1 is the floor for `schema-budget` (F13) —
    # 0.3.0 budgeted the DOCSTRING, which under FastMCP is not what crosses the
    # wire, so it flags the very pattern the fleet standardised on.
    "forge-testkit>=0.3.1",
]
{%- if mcp %}
# Heartbeat publisher (the `kafka` extra): confluent-kafka backs the Producer
# that ships {live,ready,metrics} to Pontus. Optional — a star without it just
# doesn't beat (the MCP server still serves). Image installs it via
# `uv sync --extra kafka` (see the Dockerfile).
kafka = ["confluent-kafka>=2.0"]
{%- endif %}
{%- if sovereign_database %}
# Sovereign Postgres driver, installed into the image via `uv sync --extra pg`
# (see the Dockerfile). Kept an extra, not a base dep, so non-DB stars stay lean.
pg = [
    "psycopg[binary]>=3.1",
{%- if db_kind == "pgvector" %}
    "pgvector>=0.3",
{%- endif %}
]
{%- endif %}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

# Single-source the version: hatch reads `__version__` from the package, so
# pyproject and the package never drift. Bump the literal in __init__.py only.
[tool.hatch.version]
path = "src/{{ package_name }}/__init__.py"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

# Lint / type / test baseline — the canonical Forge policy
# (furnace code-standards block).
#
# `target-version` is DELIBERATELY UNSET, so ruff infers it from
# `project.requires-python` above. It used to be the literal `py312` while
# requires-python said `>=3.14`, .python-version said 3.14 and mypy said 3.14 —
# a fourth writer of the same fact, and the only one that had gone stale. It
# silently held the whole python fleet's lint at 3.12: MEASURED 2026-08-22,
# 21 of 24 python repos resolved to 3.12, and the two that had been corrected
# to py314 by hand (athena, themis) were walked back to py312 by an ordinary
# `copier update` — pyproject is a 3-way merge seam, so the template's stale
# literal overwrote the star's correct one, and the manifest guard did not see
# it because it projects `[project]` and `dependency-groups` only, never
# `[tool.*]`.
#
# VERIFIED by execution, not by reading a doc — ruff 0.16.0 `--show-settings`
# against a fixture with requires-python `>=3.14`:
#   target-version absent -> linter/formatter unresolved_target_version = 3.14
#   target-version py312  -> 3.12 (the literal wins; this was the fleet's state)
# Leaving it unset removes the second writer instead of resynchronising it, so
# raising requires-python is now the ONE edit that moves the lint floor.
[tool.ruff]
line-length = 80


# PYDANTIC EVALUATES ANNOTATIONS AT RUNTIME, and ruff cannot know that on its
# own. Without this, TC001/TC002/TC003 see a name used only in an annotation and
# offer to move the import under `if TYPE_CHECKING:` — on a pydantic model that
# fix is a BUG, because the model is built from the annotation at import time.
#
# MEASURED 2026-08-22 by taking ruff's own fix on two stars: clio went from 190
# passing to 18 errors ("HistoryIngestEvent is not fully defined; you should
# define `datetime`"), and in thalassa `SessionTurnEvent.model_rebuild()` began
# raising PydanticUndefinedAnnotation. Every star stamped here answers
# `mcp: true` and ships pydantic models, so the exposure is the whole fleet.
#
# Naming the runtime-evaluated bases tells ruff WHEN the annotation is read, so
# it stops reporting those imports at all. That is a correction to the tool's
# model of the code, not a suppression of a finding — the rule still fires
# everywhere the annotation really is type-only.
[tool.ruff.lint.flake8-type-checking]
runtime-evaluated-base-classes = [
    "pydantic.BaseModel",
    "pydantic_settings.BaseSettings",
]

[tool.ruff.lint]
select = ["ALL"]
ignore = [
    "COM", "ISC", "Q", "E501",
    "D203", "D213",
    "ANN001", "ANN002", "ANN003", "ANN202", "ANN204", "ANN401",
    "EM", "TRY003",
    "C901", "PLR09", "PLR2004",
    "T201", "PLC0415", "FBT", "SLF001",
    "PLW0603", "TRY300", "TRY301", "ARG002",
    "PERF401", "PERF403", "A002", "EXE",
]

[tool.ruff.lint.per-file-ignores]
# EXACTLY the rules foundry-stocks' stop-justifications gate ratifies for a test
# glob: NOT_A_PACKAGE | TEST_ERGONOMICS, in ci/lib/stop_justifications.py.
# Ratified by Rob 2026-08-21 (foundry-stocks#596, 61bab337); before that the tier
# stood on a session's authority alone.
#
# THE GATE EXEMPTS AN ENTRY ONLY WHEN EVERY RULE IT NAMES IS EXEMPT, so one extra
# family voids the whole line. The list this replaces named eleven, was therefore
# exempt for nothing, and froze every star carrying it the moment anyone
# hand-committed — measured 2026-08-21, 24 of the 26 Python stars.
#
# WHY THESE SIX. S101 (pytest IS assert) and INP001 (tests are not an importable
# package) are unsatisfiable by construction, which is a different thing from a
# suppression. D / ANN / E402 / PLW1510 are satisfiable and ruled out anyway, as
# churn on test functions that buys nothing the firewall exists to buy.
#
# NOTE `S101`, NOT `S` — the old line silenced ALL of flake8-bandit in tests,
# S608 (SQL injection) included. Of the five families dropped, PLR2004 and
# SLF001 were pure dead weight: both already sit in the global `ignore` above, so
# they silenced nothing here. `PT`, `ARG` and `ERA001` were live.
#
# ⚑ ANYTHING ADDED TO THIS LINE MUST ALREADY BE IN THE GATE'S EXEMPT SET, or
# every star this template touches loses the ability to commit. Widen the gate
# first, with Rob's signoff — never widen this line to route around it.
"tests/**" = ["S101", "ANN", "D", "E402", "PLW1510", "INP001"]

# CPY001 (ruff 0.16): accept the REUSE / SPDX per-file header
# (`# SPDX-FileCopyrightText: <year> <holder>`, stamped by this template + by
# `reuse annotate` on new files per repo) instead of ruff's default literal
# "Copyright <year>".
[tool.ruff.lint.flake8-copyright]
notice-rgx = '(?i)SPDX-FileCopyrightText:.*\d{4}'

[tool.mypy]
python_version = "3.14"
strict = true
warn_return_any = true
warn_unused_configs = true
{%- if mcp %}

# confluent-kafka ships no type stubs (the optional `kafka` extra; absent in the
# CI gate env entirely). heartbeat.py lazy-imports it — ignore the missing stubs.
[[tool.mypy.overrides]]
module = ["confluent_kafka.*"]
ignore_missing_imports = true
{%- endif %}

[[tool.mypy.overrides]]
module = ["tests.*"]
disallow_untyped_defs = false
disallow_untyped_calls = false
disallow_incomplete_defs = false
check_untyped_defs = false
warn_return_any = false

[tool.pyright]
include = ["src", "tests"]
exclude = ["**/__pycache__", ".venv"]
typeCheckingMode = "strict"
pythonVersion = "3.14"
venvPath = "."
venv = ".venv"
reportUnnecessaryTypeIgnoreComment = false
reportUnknownMemberType = false
reportUnknownArgumentType = false
reportUnknownVariableType = false
reportUnknownParameterType = false
reportMissingTypeStubs = false

# The C3 FakeX-placement lint's one knob: where test doubles are SANCTIONED.
# `check_fake_placement` permits Fake*/Stub* INSIDE this package and flags them
# everywhere else, so it must name the narrowest place doubles legitimately
# live — here, the test tree.
#
# Do NOT set this to "{{ package_name }}". That is the intuitive value and it
# INVERTS the check: it sanctions doubles across all of src/ and rejects them
# from tests/, silently, while reporting green. Measured 2026-08-01: 11 of the
# 20 repos that had configured this knob by hand were set that way, their
# doubles had migrated into production modules, and every one had zero Fakes
# left in tests/. forge-testkit >=0.8.0 warns when it sees it.
#
# The other correct shape, if this star ever ships doubles for its OWN
# consumers (the way chaos.client / pontus.client / themis.testing do), is a
# dedicated sub-package: substrate_pkg = "{{ package_name }}.testing".
[tool.forge_testkit_lint]
substrate_pkg = "tests"

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]
# Coverage is measured every run; `term-missing` lists untested lines. Ratchet a
# floor up as real tests land by appending to addopts, e.g. `--cov-fail-under=70`.
addopts = "--cov={{ package_name }} --cov-report=term-missing"

[tool.coverage.run]
source = ["src"]
branch = true

# The stellar_core SDK lives on the Forgejo PyPI. The base image bakes it in, so
# the Docker build resolves it offline; this index is for local dev + lock gen.
[[tool.uv.index]]
name = "forgejo"
url = "https://forgejo.notusmi.com/api/packages/rob/pypi/simple/"

[tool.uv.sources]
stellar-core = { index = "forgejo" }
# forge-testkit is published to the Forgejo PyPI only. Without this pin uv falls
# through to the default index, where the name is unclaimed — the same class of
# failure that resolved internal `pontus` to a public Flask/S3 package of the
# same name. Index pins are per-project and are NOT inherited from a dependency.
forge-testkit = { index = "forgejo" }
{%- if core_backed %}
# Core is the public git pin (the #1300 standard); the base image bakes the
# private schema. For local co-dev against an adjacent checkout, override with
# `uv pip install -e ../mnemosyne_core` after `uv sync`.
mnemosyne-core = { git = "https://github.com/robfischer1/mnemosyne_core.git", tag = "{{ core_version }}" }
{%- endif %}
