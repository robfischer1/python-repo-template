# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Coverage reports — never commit; regenerated by `uv run pytest`
.coverage
.coverage.*
htmlcov/

# Runtime state (externalize to a volume / backing service — never commit)
*.db
*.sqlite
*.sqlite3
*-wal
*-shm
*.log
*.gz

# Local env / secrets
.env
.env.*

# furnace deploy manifest — local deploy state, regenerated on each deploy
.furnace/deployed.json

# Agent worktrees — ephemeral isolation scratch from Agent(isolation: worktree)
.claude/worktrees/

# spec-kit's surface, laid down by `specify init` as a copier task and
# regenerable by it. Same category as .claude/ — poured by a tool, not
# authored here — and the pre-commit `exclude:` above already groups the two.
# It was tracked anyway in 42 repos (1,005 files, ~24 per repo), which is not
# a decision anybody wrote down: only .specify/feature.json was ever ignored.
.specify/
