# Caller stub (Flame pull-CI) — logic in foundry/foundry-stocks; invariant, copier-shipped.
# enable-openid-connect at WORKFLOW level (and on the uses: job): the build's pin-bump
# resolves a write-capable DEPLOY_TOKEN from Calypso /fleet over Forgejo-OIDC — the stored
# token was removed from most stars by the OIDC migration. Forgejo silently ignores a
# job-level-only declaration anywhere in the reusable path.
name: build

enable-openid-connect: true

# workflow_dispatch: the ONLY way to rebuild a commit that already landed.
# A build can go green and still not deploy — if the pin-bump hits a MINTER
# FAULT reading the source commit message from the Forgejo API, it mints a
# deploy PR with no Serves trailer, which cannot advance infra's main, so the
# star silently keeps serving its old image. Without a manual trigger there is
# no way back: the change is already on main, so push: will never fire for it
# again, leaving only a junk commit or a hand-forged pin PR.
#
# Measured on arachne 2026-08-03 (arachne#1439): green build, 2-day-old
# container, a CVE fix on main that never reached the running image. Only
# chaos and nereus carried this stanza at the time; the other 16 stars and
# this template did not, so no star could recover a stranded deploy.
on:
  workflow_dispatch:
  # NO paths-ignore. It stopped this workflow RUNNING AT ALL on a docs-only push, so
  # main carried no build status for that commit and there was no push-side lever to
  # re-kick it — which is why the workflow_dispatch hand crank above exists, and why an
  # empty commit cannot re-trigger a build.
  #
  # The reusable build makes the distinction properly, INSIDE the job: its "Detect
  # source changes (skip inert-only pushes)" step gates `Load tool versions`,
  # `Publish (sha-pinned) + sign + SBOM` and `Open a deploy PR` on
  # `steps.changes.outputs.run == 'true'`, and its inert regex is a SUPERSET of the
  # patterns removed here (it also covers star.toml, .furnace/, .claude/, docs/,
  # .tfvars, .melt, justfile). So the job runs and reports SUCCESS while building,
  # publishing and deploying nothing.
  #
  # Proven on techne PR #34 before this was fanned out: the merge commit touched only
  # .forgejo/workflows/build.yml, the run logged "Only inert (governance/scaffold/docs)
  # files changed — skipping build+publish+deploy, reporting success", no package
  # version was published and no deploy PR was opened.
  push:
    branches: [main]
jobs:
  build:
    enable-openid-connect: true
    uses: foundry/foundry-stocks/.forgejo/workflows/build.yml@main
    # pragma comment: detect-secrets flags the word 'secrets' as a Secret Keyword,
    # and `secrets: inherit` is the reusable-workflow idiom, not a credential.
    secrets: inherit  # pragma: allowlist secret
